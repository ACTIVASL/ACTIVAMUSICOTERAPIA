rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // DEBUG MODE: REGLA PERMISIVA TEMPORAL PARA DIAGNÓSTICO
    // Si esto funciona, el problema era la regla estricta anterior.
    match /patients/{patientId}/{fileName} {
      allow read: if request.auth != null;
      // Write covers Create, Update, Delete.
      // For create/update (resource != null), check quota.
      // For delete (resource == null), just check Auth.
      allow write: if request.auth != null 
                   && (request.resource == null || request.resource.size < 100 * 1024 * 1024);
    }

    match /tenants/{tenantId}/files/{fileId} {
       allow read: if request.auth != null;
       allow write: if request.auth != null
                    && request.resource.size < 100 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
